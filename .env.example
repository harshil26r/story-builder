# Story Builder — full env contract (see SPEC.md §7.1)
# Copy to .env and adjust. Never commit .env.

# ── Server ────────────────────────────────────────────────────────────────
NODE_ENV=development                       # development | production
PORT=5000                                  # server listen port

# ── Database ──────────────────────────────────────────────────────────────
MONGO_URI=mongodb://127.0.0.1/story-builder

# ── Session ───────────────────────────────────────────────────────────────
SESSION_SECRET=change-me-long-random-string   # REQUIRED in production (fail-fast)

# ── Anthropic (Claude) ────────────────────────────────────────────────────
# ANTHROPIC_AUTH_TOKEN is set in this deployment (NOT ANTHROPIC_API_KEY).
# If ANTHROPIC_AUTH_TOKEN is absent, AI endpoints degrade to 503 AI_UNAVAILABLE.
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=
ANTHROPIC_API_KEY=                         # optional alias; used only if AUTH_TOKEN absent
AI_MODEL=sonnet-5                          # sonnet-5 default; opus-5 / haiku-4.5 available
AI_MAX_TOKENS_PER_CHAPTER=6000
AI_RATE_LIMIT_CALLS=15
AI_RATE_LIMIT_WINDOW_MIN=15
AI_DAILY_TOKEN_BUDGET=1000000              # optional daily token cap per user

# ── Google OAuth ──────────────────────────────────────────────────────────
# Absent creds → /api/auth/google* return 501 NOT_CONFIGURED.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
# Optional override for Google's signing certs (JWKS) endpoint — used by
# id_token verification; defaults to Google's well-known URL.
GOOGLE_CERTS_URL=

# ── Cloudinary (file storage) ─────────────────────────────────────────────
# Absent → uploads stored in server/uploads/ and served at /uploads/... .
CLOUDINARY_URL=

# ── SMTP (email for OTP) ──────────────────────────────────────────────────
# Absent → OTP codes are logged to the server console (dev fallback).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Story Builder <no-reply@storybuilder.local>

# ── CORS / uploads / versions ─────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173
UPLOAD_MAX_BYTES=5242880                   # 5MB
CONTENT_VERSION_RETENTION=10