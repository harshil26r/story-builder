{
  "name": "story-builder",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Story Builder — MERN monorepo (client + server) with AI-generated stories",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,magenta \"npm run dev -w server\" \"npm run dev -w client\"",
    "test": "npm test -w server && npm test -w client && npm run test:scripts",
    "test:scripts": "node --test scripts/tests/",
    "build": "npm run build -w server && npm run build -w client",
    "typecheck": "npm run typecheck -w client",
    "mongo:start": "bash scripts/mongo-service.sh start",
    "mongo:stop": "bash scripts/mongo-service.sh stop",
    "mongo:status": "bash scripts/mongo-service.sh status",
    "mongo:logs": "bash scripts/mongo-service.sh logs",
    "docker:mongo": "docker compose up -d mongodb",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "concurrently": "^9.1.0",
    "eslint": "10.12.0",
    "prettier": "3.9.9",
    "typescript-eslint": "8.71.1"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "bcrypt@5.1.1": true,
    "esbuild@0.21.5": true,
    "ejs@2.7.4": true,
    "protobufjs@7.6.6": true,
    "@google/genai@2.23.0": true
  }
}
