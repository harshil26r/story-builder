{
  "name": "server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Story Builder server — Express + Mongoose + Anthropic",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "node --check src/index.js && node --check src/app.js && echo 'server build ok'"
  },
